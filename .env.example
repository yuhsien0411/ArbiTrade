# Backend configuration. Copy to .env in the repository root.
# Keep credentials empty when exploring public market data.
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Bybit
BYBIT_API_KEY=
BYBIT_SECRET=

# Binance: the current implementation defaults to Portfolio Margin.
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_USE_PORTFOLIO_MARGIN=true

# OKX / Bitget: PASSWORD means the API passphrase, not a login password.
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSWORD=

# MEXC spot credentials (legacy MEXC_API_KEY / MEXC_SECRET also work).
MEXC_SPOT_API_KEY=
MEXC_SPOT_SECRET=

# Aster: main account address, API wallet address, API wallet private key.
# Never use a main wallet private key here.
ASTER_USER=
ASTER_SIGNER=
ASTER_PRIVATE_KEY=
